{
  "name": "precip",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check-inline-styles": "python3 scripts/check-no-inline-styles.py",
    "test": "bun test",
    "test:py": "python3 -m unittest discover -s tests -v",
    "biome": "biome",
    "lint": "tsc --noEmit && biome check src",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "trustedDependencies": [
    "@esbuild/darwin-arm64",
    "fsevents"
  ]
}
